<UserControl x:Class="ExplorerTabUtility.UI.Views.Controls.SystemTrayIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:managers="clr-namespace:ExplorerTabUtility.Managers"
             x:Name="ThisObject">

    <tb:TaskbarIcon x:Name="TrayIcon"
                    Visibility="Visible"
                    DataContext="{Binding ElementName=ThisObject}">

        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <!-- Window Hook -->
                <MenuItem Header="Window Hook"
                          Name="WindowHook"
                          StaysOpenOnClick="True"
                          IsCheckable="True"
                          IsChecked="{Binding Source={x:Static managers:SettingsManager.IsWindowHookActive}, Mode=OneTime}"
                          ToolTip="Toggle automatic redirection of new Explorer windows to tabs" />

                <!-- Reuse Tabs -->
                <MenuItem Header="Reuse Tabs"
                          Name="ReuseTabs"
                          StaysOpenOnClick="True"
                          IsCheckable="True"
                          IsChecked="{Binding Source={x:Static managers:SettingsManager.ReuseTabs}, Mode=OneTime}"
                          ToolTip="When enabled, navigates to existing tabs instead of opening duplicates" />

                <Separator />

                <!-- Add to startup -->
                <MenuItem Header="Add to startup"
                          Name="AddToStartup"
                          StaysOpenOnClick="True"
                          IsCheckable="True"
                          IsChecked="{Binding Source={x:Static managers:RegistryManager.IsStartupEnabled}, Mode=OneTime}"
                          ToolTip="Automatically start when Windows starts" />

                <!-- Theme issue -->
                <MenuItem Header="I have theme issues"
                          Name="ThemeIssue"
                          StaysOpenOnClick="True"
                          IsCheckable="True"
                          IsChecked="{Binding Source={x:Static managers:SettingsManager.HaveThemeIssue}, Mode=OneTime}"
                          ToolTip="Use alternative window hiding method for custom themes" />

                <Separator />

                <!-- Exit -->
                <MenuItem x:Name="ExitApplication"
                          Header="Exit"
                          ToolTip="Close Explorer Tab Lite and stop all hooks" />
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>

</UserControl>
